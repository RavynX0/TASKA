NODE_ENV=development
PORT=4310
# Comma-free; set to your deployed frontend origin in production, e.g.
# CORS_ORIGIN=https://taska.vercel.app
CORS_ORIGIN=*

# Database: either the discrete PG* vars (local dev / CI) OR a single
# DATABASE_URL (most hosts). If PGHOST is set it wins; otherwise DATABASE_URL
# is required.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=changeme
PGDATABASE=taska_dev
DATABASE_URL=postgresql://postgres:changeme@127.0.0.1:5432/taska_dev
# Hosted Postgres needs SSL. It's on automatically when NODE_ENV=production;
# force it with PGSSL=true, or disable with PGSSL=false.
# PGSSL=true

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email delivery for account-verification codes.
# Priority: BREVO_API_KEY (HTTP API) -> SMTP_* (raw SMTP) -> dev console.
# With none set in local dev, the code is printed to the server console
# instead of being emailed.
APP_NAME=Taska
MAIL_FROM="Taska <no-reply@taska.app>"   # must be a Brevo-verified sender/domain

# Option A - Brevo HTTP API (recommended; works where SMTP ports are blocked).
# Brevo dashboard -> SMTP & API -> API Keys -> create (starts with "xkeysib-").
BREVO_API_KEY=

# Option B - any SMTP provider (used only if BREVO_API_KEY is blank).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Email-verification tuning (optional - these are the defaults)
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
